@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";
    int currentUserId = int.Parse(User.FindFirst("id")?.Value);
}

<div class="d-flex flex-wrap justify-content-between gap-3 mb-3 mt-3">
    <a asp-action="Index" asp-controller="Friend" class="friendCard dashboardCards col p-3 border border-2">
        <div class="d-flex justify-content-between align-items-center">
            <span class="fs-4 text-nowrap">Friends</span>
            <i class="bi bi-people-fill fs-4"></i>
        </div>
        <div class="d-flex justify-content-between align-items-center px-3">
            <div class="d-flex flex-column align-items-center gap-2">
                <span>Accepted</span>
                <span>@Model.FriendsAccepted</span>
            </div>
            <div class="d-flex flex-column align-items-center gap-2">
                <span>Requested</span>
                <span>@Model.FriendsRequested</span>
            </div>
            <div class="d-flex flex-column align-items-center gap-2">
                <span>Pending</span>
                <span>@Model.FriendsPending</span>
            </div>
            <div class="d-flex flex-column align-items-center gap-2">
                <span>Referred</span>
                <span>@Model.FriendsReferred</span>
            </div>
        </div>
    </a>

    <div  class="groupCard dashboardCards col p-3 border border-2">
        <div class="d-flex justify-content-between align-items-center">
            <span class="fs-4 text-nowrap">Expenses</span>
            <i class="bi bi-cash fs-4"></i>
        </div>
        <div class="d-flex gap-5 align-items-center px-3">
            <div class="d-flex flex-column align-items-center gap-2">
                <a asp-action="Index" asp-controller="Group" class="text-dark">Group</a>
                <span class="@(Model.NetGroupExpense < 0 ? "text-danger" : "text-primary")">₹@Model.NetGroupExpense.ToString("N2")</span>
            </div>
            <div class="d-flex flex-column align-items-center gap-2">
                <a asp-action="Index" asp-controller="Expense" class="text-dark">Non-Group</a>
                <span class="@(Model.NetNonGroupExpense < 0 ? "text-danger" : "text-primary")">₹@Model.NetNonGroupExpense.ToString("N2")</span>
            </div>
            <div class="d-flex flex-column gap-2">
                <span>Total</span>
                <span class="pe-2 @(Model.NetExpense < 0 ? "text-danger" : "text-success")">
                    @(Model.NetExpense == 0 ? $"All expenses are settled" : (Model.NetExpense > 0 ? $"You are owed ₹{Model.NetExpense.ToString("N2")}" : $"You owe ₹{((-1) * Model.NetExpense).ToString("N2")}"))
                </span>
            </div>
        </div>
    </div>

    <div class="expenseCard dashboardCards col p-3 border border-2">
        <div class="d-flex justify-content-between align-items-center">
            <span class="fs-4 text-nowrap">Summary</span>
            <i class="bi bi-journal-text fs-4"></i>
        </div>
        <div class="d-flex gap-5 align-items-center px-3">
            <div class="d-flex flex-column align-items-center gap-2">
                <span>Paid</span>
                <span class="@(Model.TotalPaid < 0 ? "text-danger" : "text-primary")">₹@Model.TotalPaid.ToString("N2")</span>
            </div>
            <div class="d-flex flex-column align-items-center gap-2">
                <span>Settled</span>
                <span class="@(Model.TotalSettled < 0 ? "text-danger" : "text-primary")">₹@Model.TotalSettled.ToString("N2")</span>
            </div>
        </div>
    </div>
</div>

<div class="row m-0 gap-2">
    <div class="bg-white p-3 col">
        <p class="fw-semibold fs-5 text-dark-emphasis">Recent Expenses</p>
        <div class="table-responsive bg-white">
            <table class="table text-nowrap">
                <thead class="position-sticky top-0 z-1">
                    <tr>
                        <th scope="col" class="col-1">
                            <span class="text-clr-grey text-dark-emphasis">Date</span>
                        </th>
                        <th scope="col" class="col">
                            <span class="text-clr-grey text-dark-emphasis">Title</span>
                        </th>
                        <th scope="col" class="col">
                            <span class="text-clr-grey text-dark-emphasis">Type</span>
                        </th>
                        <th scope="col" class="col">
                            <span class="text-clr-grey text-dark-emphasis">Paid By</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ExpenseVM expense in Model.RecentExpenses)
                    {
                        <tr>
                            <td>
                                <span>@expense.PaidDate.ToString("dd-MM-yyyy")</span>
                            </td>
                            <td>
                                @if(expense.GroupId != null && expense.GroupId > 0)
                                {
                                    <a asp-action="ViewGroupExpense" asp-controller="Expense" asp-route-expenseId="@expense.Id">
                                        <span class="text-dark">@expense.Title</span>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="ViewIndividualExpense" asp-controller="Expense" asp-route-expenseId="@expense.Id">
                                        <span class="text-dark">@expense.Title</span>
                                    </a>
                                }
                            </td>
                            <td>
                                <span>@(expense.GroupId != null && expense.GroupId > 0 ? "Group" : "Individual")</span>
                            </td>
                            <td>
                                <span>@(expense.PaidById == currentUserId ? "You" : expense.PaidByName)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.RecentExpenses.Count() == 0)
        {
            <p class="p-4 text-center">No recent expenses found</p>
        }
    </div>

    <div class="bg-white p-3 col">
        <p class="fw-semibold fs-5 text-dark-emphasis">Recent Payments</p>
        <div class="table-responsive bg-white">
            <table class="table text-nowrap">
                <thead class="position-sticky top-0 z-1">
                    <tr>
                        <th scope="col" class="col">
                            <span class="text-clr-grey text-dark-emphasis">Date</span>
                        </th>
                        <th scope="col" class="col">
                            <span class="text-clr-grey text-dark-emphasis">Details</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Payment payment in Model.RecentPayments)
                    {
                        string paidByName = payment.PaidById == currentUserId ? "You" : $"{payment.PaidByUser.FirstName} {payment.PaidByUser.LastName}";
                        string paidToName = payment.PaidToId == currentUserId ? "You" : $"{payment.PaidToUser.FirstName} {payment.PaidToUser.LastName}";

                        <tr>
                            <td>
                                <span>@payment.CreatedAt.ToString("dd-MM-yyyy"), @payment.CreatedAt.ToString("HH:mm:ss")</span>
                            </td>
                            <td>
                                <span>
                                    @($"{paidByName} paid ₹{payment.Amount.ToString("N2")} to {paidToName}.")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.RecentPayments.Count() == 0)
        {
            <p class="p-4 text-center">No recent payments found</p>
        }
    </div>
</div>