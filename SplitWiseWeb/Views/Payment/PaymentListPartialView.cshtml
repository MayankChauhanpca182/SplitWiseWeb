@model PaginatedListVM<Payment>
@{
    int currentUserId = int.Parse(User.FindFirst("id")?.Value);
}

<div class="table-responsive bg-white px-2">
    <table class="table table-striped text-nowrap">
        <thead class="">
            <tr>
                <th scope="col" class="col-2">
                    <span class="text-clr-grey text-dark-emphasis">Date</span>
                    <button class="btn p-0 sortBtn" data-column="date" data-order="asc" title="Asc">
                        <i class="bi bi-arrow-up"></i>
                    </button>
                    <button class="btn p-0 sortBtn" data-column="date" data-order="desc" title="Desc">
                        <i class="bi bi-arrow-down"></i>
                    </button>
                </th>
                <th scope="col" class="col">
                    <span class="text-clr-grey text-dark-emphasis">Details</span>
                    <button class="btn p-0 sortBtn" data-column="amount" data-order="asc" title="Asc">
                        <i class="bi bi-arrow-up"></i>
                    </button>
                    <button class="btn p-0 sortBtn" data-column="amount" data-order="desc" title="Desc">
                        <i class="bi bi-arrow-down"></i>
                    </button>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (Payment payment in Model.List)
            {
                string paidByName = payment.PaidById == currentUserId ? "You" : $"{payment.PaidByUser.FirstName} {payment.PaidByUser.LastName}";
                string paidToName = payment.PaidToId == currentUserId ? "You" : $"{payment.PaidToUser.FirstName} {payment.PaidToUser.LastName}";

                <tr>
                    <td>
                        <span>@payment.CreatedAt.ToString("dd-MM-yyyy"), @payment.CreatedAt.ToString("HH:mm:ss")</span>
                    </td>
                    <td>
                        <span><strong>@paidByName</strong></span>
                        <span>paid</span>
                        <span><strong>₹@payment.Amount.ToString("N2")</strong></span>
                        <span>to</span>
                        <span><strong>@paidToName.</strong></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!(Model.Page.TotalRecord > 0))
{
    <p class="p-4 text-center">No transactions found</p>
}
else
{
    <!-- Pagination -->
    <div class="pagination d-flex flex-column flex-sm-row justify-content-start align-items-sm-center mt-3 px-1 pb-3">
        <div class="d-flex align-items-center">
            <span class="mx-1">Items Per page: </span>
            <select class="form-select w-auto mx-1" id="transactionListPageSize" onchange="fetchFriendTransactions(1)"
                aria-label="Default select example" title="Page Size">
                <option value="5" selected="@(Model.Page.PageSize == 5 ? true : false)">5</option>
                <option value="10" selected="@(Model.Page.PageSize == 10 ? true : false)">10</option>
                <option value="15" selected="@(Model.Page.PageSize == 15 ? true : false)">15</option>
            </select>
        </div>
        <span class="mx-1">
            Showing @Model.Page.FromRec - @Model.Page.ToRec of @Model.Page.TotalRecord
        </span>
        <div>
            <button class="btn p-1 border @(Model.Page.CurrentPage > 1 ? " " : "disabled")"
                onclick="fetchFriendTransactions(@Model.Page.CurrentPage-1)" title="Prev page">
                <i class="bi bi-chevron-left p-1"></i>
            </button>
            <button class="btn p-1 border @(Model.Page.CurrentPage < Model.Page.TotalPages ? " " : "disabled")"
                onclick="fetchFriendTransactions(@Model.Page.CurrentPage+1)" title="Next page">
                <i class="bi bi-chevron-right p-1"></i>
            </button>
        </div>
    </div>
    <!-- Pagination end -->
}