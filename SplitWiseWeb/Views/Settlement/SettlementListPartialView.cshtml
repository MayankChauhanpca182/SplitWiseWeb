@model PaginatedListVM<SettlementListVM>

<div class="table-responsive bg-white">
    <table class="table table-striped text-nowrap">
        <thead>
            <tr>
                <th scope="col" class="col-3">
                    <span class="text-clr-grey text-dark-emphasis">Name</span>
                    <button class="btn p-0 sortBtn" data-column="name" data-order="asc" title="Asc">
                        <i class="bi bi-arrow-up"></i>
                    </button>
                    <button class="btn p-0 sortBtn" data-column="name" data-order="desc" title="Desc">
                        <i class="bi bi-arrow-down"></i>
                    </button>
                </th>
                <th scope="col" class="col-4">
                    <span class="text-clr-grey text-dark-emphasis">Email</span>
                    <a class="btn p-0 sortBtn" data-column="email" data-order="asc" title="Asc">
                        <i class="bi bi-arrow-up"></i>
                    </a>
                    <a class="btn p-0 sortBtn" data-column="email" data-order="desc" title="Desc">
                        <i class="bi bi-arrow-down"></i>
                    </a>
                </th>
                <th scope="col" class="col">
                    <span class="text-clr-grey text-dark-emphasis">Expense</span>
                </th>
                <th scope="col" class="col-1 text-end">
                    <span class="text-clr-grey text-dark-emphasis">Actions</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (SettlementListVM settlement in Model.List)
            {
                <tr>
                    <td>
                        <img src="@Url.Content(settlement.ProfileImagePath ?? "~/images/Default_pfp.png")" class="img-40px object-fit-cover rounded-circle border border-secondary-subtle">
                        <span class="ms-1">@settlement.Name</span>
                    </td>
                    <td>@settlement.EmailAddress</td>
                    <td
                        class="@(settlement.Expense < 0 ? "text-danger" : "text-success")">
                        @(settlement.Expense == 0 ? $"Expense is settled" : (settlement.Expense > 0 ? $"You are owed ₹{settlement.Expense.ToString("N2")}" : $"You owe ₹{((-1)*settlement.Expense).ToString("N2")}"))
                    </td>
                    <td class="text-end">
                        <a asp-controller="Settlement" asp-action="SettleUp" asp-route-friendUserId="@settlement.UserId" class="btn border-0" title="Settle Up">
                            <i class="bi bi-credit-card"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!(Model.Page.TotalRecord > 0))
{
    <p class="p-4 text-center">No records found</p>
}
else
{
    <!-- Pagination -->
    <div class="pagination d-flex flex-column flex-sm-row justify-content-start align-items-sm-center mt-3 px-1 pb-3">
        <div class="d-flex align-items-center">
            <span class="mx-1">Items Per page: </span>
            <select class="form-select w-auto mx-1" id="settlementPageSize" onchange="getSettlementList(1)"
                aria-label="Default select example" title="Page Size">
                <option value="5" selected="@(Model.Page.PageSize == 5 ? true : false)">5</option>
                <option value="10" selected="@(Model.Page.PageSize == 10 ? true : false)">10</option>
                <option value="15" selected="@(Model.Page.PageSize == 15 ? true : false)">15</option>
            </select>
        </div>
        <span class="mx-1">
            Showing @Model.Page.FromRec - @Model.Page.ToRec of @Model.Page.TotalRecord
        </span>
        <div>
            <button class="btn p-1 border @(Model.Page.CurrentPage > 1 ? " " : "disabled")"
                onclick="getSettlementList(@Model.Page.CurrentPage-1)" title="Prev page">
                <i class="bi bi-chevron-left p-1"></i>
            </button>
            <button class="btn p-1 border @(Model.Page.CurrentPage < Model.Page.TotalPages ? " " : "disabled")"
                onclick="getSettlementList(@Model.Page.CurrentPage+1)" title="Next page">
                <i class="bi bi-chevron-right p-1"></i>
            </button>
        </div>
    </div>
    <!-- Pagination end -->
}