@{
    ViewData["Title"] = "Non-Group Expenses";
}

<breadcrumb></breadcrumb>
<h3 class="bg-white mb-3 p-3 text-dark-emphasis shadow">Non-Group Expenses</h3>

<div class="bg-white p-3">
    <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
        <div class="d-flex align-items-center gap-2">
            <input type="text" class="searchBox form-control border-secondary-subtle rounded-0"
                id="nonGroupExpenseListSearch" placeholder="Search">
            <div class="form-check">
                <input class="form-check-input border border-secondary-subtle" type="checkbox" value=""
                    id="systemExpensesCkb" onchange="getNonGroupExpenseList(1)">
                <label class="form-check-label text-nowrap" for="systemExpensesCkb">
                    Show system expenses
                </label>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary w-125px" type="button" onclick="exportNonGroupExpenses()">Export</button>
            <a asp-action="AddNonGroupExpense" asp-controller="Expense" class="btn btn-primary w-125px"
                type="button">Add Expense</a>
        </div>
    </div>
    <div id="nonGroupExpenseListOuter" class="listOuter bg-white"></div>
</div>


@section Scripts {
    @* NonGroup expence list *@
    <script>
        sortColumn = "";
        sortOrder = "";

        $(document).ready(function () {
            getNonGroupExpenseList(1);
        });

        $("#nonGroupExpenseListSearch").on("input", function () {
            if (searchTimeout === null) {
                searchTimeout = setTimeout(function () {
                    getNonGroupExpenseList(1);
                }, 500);
            }
        });

        function getNonGroupExpenseList(currentPage = 1) {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                PageNumber: currentPage,
                PageSize: $("#nonGroupExpensePageSize").val(),
                SearchString: $("#nonGroupExpenseListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder,
                IsSystemGenerated: $("#systemExpensesCkb").prop("checked")
            };

            $.ajax({
                url: "/Expense/NonGroupExpenseList",
                type: "POST",
                data: { filter },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#nonGroupExpenseListOuter").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        // Handle sorting
        $(document).on("click", ".sortBtn", function () {
            sortColumn = $(this).data("column");
            sortOrder = $(this).data("order");
            getNonGroupExpenseList(1);
        });
    </script>

    @* Export non group expenses *@
    <script>
        function exportNonGroupExpenses() {
            let filter = {
                SearchString: $("#nonGroupExpenseListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder,
                IsSystemGenerated: $("#systemExpensesCkb").prop("checked")
            };

            exportExcelAjax(filter, "/Expense/ExportNonGroupExpenses", "Non_Group_Expenses");
        }
    </script>
}