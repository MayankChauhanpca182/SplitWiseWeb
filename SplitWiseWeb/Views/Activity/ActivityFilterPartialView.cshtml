@model ActivityFilterVM

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <div class="d-flex align-items-center gap-3">
        <div class="custom-form-floating form-floating">
            <input type="text" class="activitySearch searchBox form-control border-secondary-subtle rounded-0 my-1"
                id="activitySearch" placeholder="Search">
            <label for="activitySearch">Search</label>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="custom-form-floating form-floating">
            <input type="date" class="form-control border-secondary-subtle rounded-0" id="fromDate" value="@Model.FirstDay.ToString("yyyy-MM-dd")" min="@Model.MinDate.ToString("yyyy-MM-dd")" max="@Model.MaxDate.ToString("yyyy-MM-dd")">
            <label for="fromDate">From Date</label>
        </div>
        <div class="custom-form-floating form-floating">
            <input type="date" class="form-control border-secondary-subtle rounded-0" id="toDate" value="@Model.LastDay.ToString("yyyy-MM-dd")" min="@Model.MinDate.ToString("yyyy-MM-dd")" max="@Model.MaxDate.ToString("yyyy-MM-dd")">
            <label for="toDate">To Date</label>
        </div>
    </div>
</div>