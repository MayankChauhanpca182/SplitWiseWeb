@using SplitWiseService.Helpers
@{
    DateTime firstDay = DateHelper.FirstDayOfMonth(DateTime.Now);
    DateTime lastDay = DateHelper.LastDayOfMonth(DateTime.Now);
}
<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <div class="d-flex align-items-center gap-3">
        <div class="form-floating">
            <input type="text" class="activitySearch searchBox form-control border-secondary-subtle rounded-0 my-1"
                id="activitySearch" placeholder="Search">
            <label for="activitySearch">Search</label>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="form-floating">
            <input type="date" class="form-control border-secondary-subtle rounded-0" id="fromDate" value="@firstDay.ToString("yyyy-MM-dd")">
            <label for="fromDate">From Date</label>
        </div>
        <div class="form-floating">
            <input type="date" class="form-control border-secondary-subtle rounded-0" id="toDate" value="@lastDay.ToString("yyyy-MM-dd")">
            <label for="toDate">To Date</label>
        </div>
    </div>
</div>