@using Microsoft.Extensions.Primitives
@using SplitWiseRepository.Constants
@model ActivityListVM
@{
    int currentUserId = int.Parse(User.FindFirst("id")?.Value);
    string userName = Context.Request.Cookies["UserName"];
    string date = string.Empty;
    bool isGroupActivity = Model.GroupId != null;
}

@if (Model.Activities.Count() == 0)
{
    <p class="p-4 text-center">There are no activities</p>
}
else
{
    @foreach (Activity activity in Model.Activities)
    {
        string performedByUserName = activity.PerformedById == currentUserId ? "You" : activity.PerformedByUser.FirstName + " "
        + activity.PerformedByUser.LastName;

        string performedOnUserName = string.Empty;
        @if (activity.PerformedOnUser != null)
        {
            performedOnUserName = activity.PerformedOnId == currentUserId ? "You" : activity.PerformedOnUser.FirstName + " " +
            activity.PerformedOnUser.LastName;
        }

        bool isPerformedByUserMember = true;
        bool isPerformedOnUserMember = true;

        @if (Model.GroupId != null && activity.Group != null)
        {
            isPerformedByUserMember = activity.Group.GroupMembers.Any(gm => gm.DeletedAt == null && gm.UserId ==
            activity.PerformedById);

            @if (activity.PerformedOnUser != null)
            {
                isPerformedOnUserMember = activity.Group.GroupMembers.Any(gm => gm.DeletedAt == null && gm.UserId ==
                activity.PerformedOnId);
            }
        }


        @if (date != activity.CreatedAt.ToString("dd-MM-yyyy"))
        {
            date = activity.CreatedAt.ToString("dd-MM-yyyy");
            <p class="activityDivider">
                <span>---------------------</span>
                <span>@activity.CreatedAt.ToString("dd"),</span>
                <span>@activity.CreatedAt.ToString("MMMM")</span>
                <span>@activity.CreatedAt.ToString("yyyy")</span>
                <span>---------------------</span>
            </p>
        }

        <div class="actvityItem">
            @switch (activity.ActivityType)
            {
                case ActivityType.GroupCreated:
                case ActivityType.MemberAdded:
                case ActivityType.GroupExpenseAdded:
                case ActivityType.ExpenseAdded:
                    <i class="bi bi-circle-fill text-primary"></i>
                    break;

                case ActivityType.GroupPaymenent:
                case ActivityType.NonGroupPaymenent:
                    <i class="bi bi-circle-fill text-blue"></i>
                    break;

                case ActivityType.GroupUpdated:
                case ActivityType.GroupExpenseUpdated:
                case ActivityType.ExpenseUpdated:
                    <i class="bi bi-circle-fill text-orange"></i>
                    break;

                case ActivityType.GroupDeleted:
                case ActivityType.MemberRemoved:
                case ActivityType.LeaveGroup:
                    <i class="bi bi-circle-fill text-danger"></i>
                    break;
            }

            <span class="text-nowrap">@activity.CreatedAt.ToString("HH:mm:ss") : </span>
            <span>
                <span class="@(isPerformedByUserMember ? "" : "opacity-75")">
                    <img src="@(activity.PerformedByUser.ProfileImagePath ?? "/images/Default_pfp.png")" alt=""
                        class="img-20px img-20px rounded-circle">
                    <strong>@performedByUserName</strong>
                </span>

                @switch (activity.ActivityType)
                {
                    case ActivityType.GroupCreated:
                        <span>created the group</span>
                        <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                            class="img-20px rounded-circle">
                        <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        break;

                    case ActivityType.GroupUpdated:
                        <span>updated the group</span>
                        <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                            class="img-20px rounded-circle">
                        <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        break;

                    case ActivityType.GroupDeleted:
                        <span>deleted the group</span>
                        <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                            class="img-20px rounded-circle">
                        <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        break;

                    case ActivityType.MemberAdded:
                        <span>added</span>
                        <span class="@(isPerformedOnUserMember ? "" : "opacity-75")">
                            <img src="@(activity.PerformedOnUser.ProfileImagePath ?? "/images/Default_pfp.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@performedOnUserName</strong>
                        </span>
                        if (isGroupActivity)
                        {
                            <span>to this group.</span>
                        }
                        else
                        {
                            <span>to the group</span>
                            <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        }
                        break;

                    case ActivityType.MemberRemoved:
                        <span>removed</span>
                        <span class="@(isPerformedOnUserMember ? "" : "opacity-75")">
                            <img src="@(activity.PerformedOnUser.ProfileImagePath ?? "/images/Default_pfp.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@performedOnUserName</strong>
                        </span>
                        if (isGroupActivity)
                        {
                            <span>from this group.</span>
                        }
                        else
                        {
                            <span>from the group</span>
                            <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        }
                        break;

                    case ActivityType.GroupExpenseAdded:
                        <span>added an expense</span>
                        <strong>@(activity.Expense.Title)</strong>
                        <span>of</span>
                        <strong>₹@(activity.Amount ?? activity.Expense.Amount.ToString("N2"))</strong>
                        if (isGroupActivity)
                        {
                            <span>in this group.</span>
                        }
                        else
                        {
                            <span>in the group</span>
                            <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        }
                        break;
                    case ActivityType.GroupExpenseUpdated:
                        <span>updated an expense</span>
                        <strong>@(activity.Expense.Title)</strong>
                        if (isGroupActivity)
                        {
                            <span>in this group.</span>
                        }
                        else
                        {
                            <span>in the group</span>
                            <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        }
                        @if (!string.IsNullOrEmpty(activity.AdditionalDetails))
                        {
                            <span>(@Html.Raw(activity.AdditionalDetails.Replace(userName, "You")))</span>

                        }
                        break;

                    case ActivityType.LeaveGroup:
                        if (isGroupActivity)
                        {
                            <span>left the group.</span>
                        }
                        else
                        {
                            <span>left the group</span>
                            <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        }
                        break;

                    case ActivityType.GroupPaymenent:
                        <span>paid</span>
                        <strong>₹@activity.Payment.Amount.ToString("N2")</strong>
                        <span>to</span>
                        <span class="@(isPerformedOnUserMember ? "" : "opacity-75")">
                            <img src="@(activity.PerformedOnUser.ProfileImagePath ?? "/images/Default_pfp.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@performedOnUserName</strong>
                        </span>
                        if (isGroupActivity)
                        {
                            <span>in this group.</span>
                        }
                        else
                        {
                            <span>in the group</span>
                            <img src="@(activity.Group.ImagePath ?? "/images/default_group_img.png")" alt=""
                                class="img-20px rounded-circle">
                            <strong>@(activity.GroupName ?? activity.Group.Name).</strong>
                        }
                        break;

                    case ActivityType.NonGroupPaymenent:
                        <span>paid</span>
                        <strong>₹@activity.Payment.Amount.ToString("N2")</strong>
                        <span>to</span>
                        <img src="@(activity.PerformedOnUser.ProfileImagePath ?? "/images/Default_pfp.png")" alt=""
                            class="img-20px rounded-circle">
                        <strong>@performedOnUserName.</strong>
                        break;

                    case ActivityType.ExpenseAdded:
                        <span>added an expense</span>
                        <strong>@(activity.Expense.Title)</strong>
                        <span>of</span>
                        <strong>₹@(activity.Amount ?? activity.Expense.Amount.ToString("N2")).</strong>
                        break;

                    case ActivityType.ExpenseUpdated:
                        <span>updated an expense</span>
                        <strong>@(activity.Expense.Title).</strong>
                        @if (!string.IsNullOrEmpty(activity.AdditionalDetails))
                        {
                            <span>(@Html.Raw(activity.AdditionalDetails.Replace(userName, "You")))</span>

                        }
                        break;
                }
            </span>
        </div>
    }
}