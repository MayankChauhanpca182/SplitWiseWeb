@model ActivityFilterVM
@{
    ViewData["Title"] = "User Activities";
}

<breadcrumb></breadcrumb>
<h3 class="bg-white mb-3 p-3 text-dark-emphasis shadow">User Activities</h3>

<div class="bg-white p-3">
    <partial name="ActivityFilterPartialView" model="@Model"/>
    <div id="user-activity-outer" class="listOuter"></div>
</div>

@section Scripts {
    <script src="/js/activity.js"></script>
    <script>
        function fetchActivities() {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                SearchString: $("#activitySearch").val(),
                FromDate: $("#fromDate").val(),
                ToDate: $("#toDate").val()
            };

            if ((!filter.FromDate || !filter.ToDate) && !(filter.FromDate && filter.ToDate))
            {
                return;
            }
            else if (filter.FromDate && filter.ToDate) {
                if (filter.FromDate > filter.ToDate) {
                    toastr.error("From Date should be greater then To Date.")
                    $("#toDate").val("");
                    return;
                }
            }

            $.ajax({
                url: "/Activity/ActivityList",
                type: "POST",
                data: { filter },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#user-activity-outer").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error("Internal server error");
                }
            });
        }
    </script>

    @* Export activity *@
    <script>
        // Export activities
        function exportActivities() {
            let filter = {
                SearchString: $("#activitySearch").val(),
                FromDate: $("#fromDate").val(),
                ToDate: $("#toDate").val()
            };

            exportDataAjax(filter, "/Activity/ExportActivity", "UserActivities");
        }
    </script>
}