@model List<Activity>
@{
    ViewData["Title"] = "User Activities";
}

<breadcrumb></breadcrumb>
<h3 class="bg-white mb-3 p-3 text-dark-emphasis shadow">User Activities</h3>

<div class="bg-white p-3">
    <div class="d-flex align-items-center gap-3 mb-3">
        <input type="text" class="activitySearch searchBox form-control border-secondary-subtle rounded-0 my-1"
            id="userActivitySearch" placeholder="Search">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="allActivitiesCbk">
            <label class="form-check-label" for="allActivitiesCbk">Show all activities</label>
        </div>
    </div>
    <div id="user-activity-outer" class="listOuter">
        <partial name="ActivityList" model="@Model" />
    </div>
</div>

