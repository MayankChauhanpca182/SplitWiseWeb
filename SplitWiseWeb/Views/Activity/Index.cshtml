@model ActivityFilterVM
@{
    ViewData["Title"] = "User Activities";
}

<breadcrumb></breadcrumb>
<h3 class="bg-white mb-3 p-3 text-dark-emphasis shadow">Activities</h3>

<div class="bg-white p-3">
    <partial name="ActivityFilterPartialView" model="@Model" />
    <div id="user-activity-outer" class="listOuter"></div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/activity.js")"></script>
    <script>
        function fetchActivities() {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                SearchString: $("#activitySearch").val(),
                FromDate: $("#fromDate").val(),
                ToDate: $("#toDate").val()
            };

            $.ajax({
                url: baseUrl + "Activity/ActivityList",
                type: "POST",
                data: { filter },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#user-activity-outer").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>

    @* Export activity *@
    <script>
        // Export activities
        function exportActivities() {
            if (validateDates()) {
                let filter = {
                    SearchString: $("#activitySearch").val(),
                    FromDate: $("#fromDate").val(),
                    ToDate: $("#toDate").val()
                };

                exportExcelAjax(filter, "/Activity/ExportActivity", "UserActivities");
            }
        }
    </script>
}