@model GroupVM
@{
    ViewData["Title"] = "Group Details";
    int currentUserId = int.Parse(User.FindFirst("id")?.Value);
}

<breadcrumb></breadcrumb>
<h3
    class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white mb-3 p-3 text-dark-emphasis shadow">
    <div class="d-flex align-items-center gap-3" id="group-name">
        <img src="@Url.Content(Model.ImagePath ?? "~/images/default_group_img.png")" alt="Image" class="rounded-circle border border-dark-subtle object-fit-cover" id="groupImage" width="70px" height="70px">
        <div class="d-flex flex-column">
            <span>
                <span id="groupName">@Model.Name</span>
                <button type="button" class="btn border-0 px-0" title="Edit Group" onclick="fetchAddGroupModal(@Model.Id)">
                    <i class="bi bi-pencil-square"></i>
                </button>
            </span>
            <span class="fs-5 fw-normal @(Model.Expense < 0 ? "text-danger" : "text-success")" id="groupExpense">
                @(Model.Expense == 0 ? $"Expense is settled" : (Model.Expense > 0 ? $"You are owed ₹{Model.Expense.ToString("N2")}" : $"You owe ₹{((-1) * Model.Expense).ToString("N2")}"))
            </span>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-primary" type="button" onclick="addgroupMemberModal(@Model.Id)">Add New Member</button>
        <button type="button" class="btn btn-secondary back-btn">Back</button>
    </div>
</h3>

<div class="bg-white p-3" id="groupDetailContainer">
    <ul class="nav nav-underline mb-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="group-expenses-tab" data-bs-toggle="pill"
                data-bs-target="#group-expenses" type="button" role="tab" aria-controls="group-expenses"
                aria-selected="false" onclick="getGroupExpenseList(1), fetchGroupName()">Expenses</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="group-activity-tab" data-bs-toggle="pill" data-bs-target="#group-activity"
                type="button" role="tab" aria-controls="group-activity" aria-selected="false"
                onclick="searchActivities(), fetchGroupName()">Activities</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="group-settleup-tab" data-bs-toggle="pill" data-bs-target="#group-settleup"
                type="button" role="tab" aria-controls="group-settleup" aria-selected="false"
                onclick="fetchGroupSettleUps('@Model.Id'), fetchGroupName()">Settle Up</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="group-members-tab" data-bs-toggle="pill" data-bs-target="#group-members"
                type="button" role="tab" aria-controls="group-members" aria-selected="true"
                onclick="fetchGroupMembers(), fetchGroupName()">Members</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="group-noticeboard-tab" data-bs-toggle="pill"
                data-bs-target="#group-noticeboard" type="button" role="tab" aria-controls="group-noticeboard"
                aria-selected="true" onclick="fetchGroupName()">Notice Board</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="group-analytics-tab" data-bs-toggle="pill" data-bs-target="#group-analytics"
                type="button" role="tab" aria-controls="group-analytics" aria-selected="true"
                onclick="fetchGroupAnalytics(@Model.Id), fetchGroupName()">Analytics</button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="group-expenses" role="tabpanel" aria-labelledby="group-expenses-tab">
            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <input type="text" class="searchBox form-control border-secondary-subtle rounded-0"
                        id="groupExpenseListSearch" placeholder="Search">
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary w-125px" type="button" onclick="exportGroupExpenses()">Export</button>
                    <a asp-action="AddGroupExpense" asp-controller="Expense" asp-route-groupId="@Model.Id"
                        class="btn btn-primary w-125px" type="button">Add Expense</a>
                </div>
            </div>
            <div id="groupExpensesOuter" class="listOuter bg-white"></div>
        </div>

        <div class="tab-pane fade" id="group-activity" role="tabpanel" aria-labelledby="group-activity-tab">
            <partial name="../Activity/ActivityFilterPartialView" model="@Model.ActivityFilter" />
            <div id="group-activity-outer" class="listOuter"></div>
        </div>

        <div class="tab-pane fade" id="group-settleup" role="tabpanel" aria-labelledby="group-settleup-tab"></div>

        <div class="tab-pane fade" id="group-members" role="tabpanel" aria-labelledby="group-members-tab"></div>

        <div class="tab-pane fade" id="group-noticeboard" role="tabpanel" aria-labelledby="group-noticeboard-tab">
            <div class="input-group mt-4 rounded-0">
                <textarea asp-for=@Model.NoticeBoard id="groupNoticeBoard"
                    class="groupNoticeBoard form-control border-secondary-subtle rounded-0" placeholder=""
                    rows="10" disabled></textarea>
            </div>
        </div>

        <div class="tab-pane fade" id="group-analytics" role="tabpanel" aria-labelledby="group-analytics-tab"></div>
    </div>
</div>

@section Scripts {

    <script src="@Url.Content("~/js/group.js")"></script>

    @* Group name *@
    <script>
        function fetchGroupName() {
            $.ajax({
                url: baseUrl + "Group/GroupDetailJson",
                type: "GET",
                data: { groupId: '@Model.Id' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#groupExpense").removeClass("text-success").removeClass("text-danger");
                            $("#groupImage").prop("src", baseUrl + `${response.imagePath?.replace("~/", "") ?? "images/default_group_img.png"}`);
                            $("#groupName").text(response.name);
                            $("#groupNoticeBoard").text(response.noticeBoard);
                            
                            if(response.expense < 0){
                                $("#groupExpense").addClass("text-danger");
                                $("#groupExpense").text(`You owe ₹${formatToINR((-1)*response.expense)}`);
                            }
                            else if(response.expense === 0){
                                $("#groupExpense").addClass("text-success");
                                $("#groupExpense").text(`Expense is settled`);
                            }
                            else{
                                $("#groupExpense").addClass("text-success");
                                $("#groupExpense").text(`You are owed ₹${formatToINR(response.expense)}`);
                            }
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>

    @* Group members *@
    <script>
        // Fetch group members
        function fetchGroupMembers() {
            $("#group-members").empty();
            $.ajax({
                url: baseUrl + "Group/GroupMembers",
                type: "GET",
                data: { groupId: '@Model.Id' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#group-members").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        // Fetch add new member modal
        function addgroupMemberModal(groupId) {
            $("#largeModalContent").empty();
            selectedUserIds = [];
            $.ajax({
                url: baseUrl + "Group/AddgroupMemberModal",
                type: "GET",
                data: { groupId },
                success: function (response) {
                    if (!response.statusCode) {
                        $("#largeModalContent").html(response);
                        $("#largeModal").modal("show");
                    }
                },
                error: function () {
                    $("#largeModal").modal("hide");
                    toastr.error(SERVER_ERR);
                },
            });
        }

        // Remove group member
        function removeGroupMemberConfirm(groupMemberId) {
            $.ajax({
                url: baseUrl + "Group/RemoveGroupMembers",
                type: "POST",
                data: { groupMemberId },
                success: function (response) {
                    $("#confirmationModal").modal("hide");
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            toastr.success(response.message);
                            // Update member list
                            fetchGroupMembers();
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        function leaveGroupConfirm(groupMemberId) {
            $.ajax({
                url: baseUrl + "Group/RemoveGroupMembers",
                type: "POST",
                data: { groupMemberId },
                success: function (response) {
                    $("#confirmationModal").modal("hide");
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            toastr.success(response.message);
                            // Redirect to group list
                            window.location = baseUrl + "groups";
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        function removeGroupMember(groupMemberId, userName) {
            $("#confirmationModalTitle").text(`Remove group member`);
            $("#confirmationModalBody").html(`<span>Are you sure you want to remove <strong>${userName}</strong> from group?</span>`);
            $("#confirmationModalYesBtn").attr("onclick", `removeGroupMemberConfirm(${groupMemberId})`);
            $("#confirmationModal").modal("show");
        }

        function leaveGroup(groupMemberId) {
            $("#confirmationModalTitle").text(`Leave group`);
            $("#confirmationModalBody").html(`<span>Are you sure you want to leave this group?</span>`);
            $("#confirmationModalYesBtn").attr("onclick", `leaveGroupConfirm(${groupMemberId})`);
            $("#confirmationModal").modal("show");
        }

        function leaveAndDeleteGroup(groupMemberId) {
            $("#confirmationModalTitle").text(`Leave and delete group`);
            $("#confirmationModalBody").html(`<span>Are you sure you want to leave and delete this group?</span>`);
            $("#confirmationModalYesBtn").attr("onclick", `leaveGroupConfirm(${groupMemberId})`);
            $("#confirmationModal").modal("show");
        }

    </script>

    @* Add new member *@
    <script>
        $(document).on("change", ".userCkb", function () {
            let userId = $(this).data("userid");

            if (selectedUserIds.includes(userId)) {
                selectedUserIds = selectedUserIds.filter(n => n !== userId);
            }
            else {
                selectedUserIds.push(userId);
            }
        });

        function checkSelectedUsers() {
            $(".userCkb").each(function () {
                let userId = $(this).data("userid");
                $(this).prop("checked", selectedUserIds.includes(userId));
            });
        }

        function addSelectedMembers() {
            if (!selectedUserIds.length) {
                toastr.error("Select atleast one friend.")
            }
            else {
                $.ajax({
                    url: baseUrl + "Group/AddSelectedUsers",
                    type: "POST",
                    data: { groupId: @Model.Id, selectedUserIds },
                    success: function (response) {
                        if (!response.statusCode) {
                            if (response.success == false) {
                                toastr.error(response.message);
                            }
                            else {
                                toastr.success(response.message);
                                getFriendList(1);
                                fetchGroupMembers();
                                searchActivities();
                                selectedUserIds = [];
                                $("#largeModal").modal("hide");
                            }
                        }
                    },
                    error: function () {
                        toastr.error(SERVER_ERR);
                    }
                });
            }
        }
    </script>

    @* Group expenses *@
    <script>
        sortColumn = "";
        sortOrder = "";

        $(document).ready(function () {
            getGroupExpenseList(1);
        });

        $("#groupExpenseListSearch").on("input", function () {
            if (searchTimeout === null) {
                searchTimeout = setTimeout(function () {
                    getGroupExpenseList(1);
                }, 500);
            }
        });

        function getGroupExpenseList(currentPage = 1) {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                PageNumber: currentPage,
                PageSize: $("#groupExpensePageSize").val(),
                SearchString: $("#groupExpenseListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder
            };

            $.ajax({
                url: baseUrl + "Expense/ExpensesByGroup",
                type: "POST",
                data: { filter, groupId: '@Model.Id' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#groupExpensesOuter").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        // Handle sorting
        $(document).on("click", ".sortBtn", function () {
            sortColumn = $(this).data("column");
            sortOrder = $(this).data("order");
            getGroupExpenseList(1);
        });
    </script>

    @* Group activities *@
    <script src="@Url.Content("~/js/activity.js")"></script>
    <script>
        // Fetch activities
        function fetchActivities() {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                SearchString: $("#activitySearch").val(),
                FromDate: $("#fromDate").val(),
                ToDate: $("#toDate").val()
            };

            $.ajax({
                url: baseUrl + "Activity/ActivityList",
                type: "POST",
                data: { filter, groupId: '@Model.Id' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#group-activity-outer").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>

    @* Group settlements *@
    <script>
        // Fetch settlements
        function fetchGroupSettleUps(groupId) {
            $("#group-settleup").empty();
            $.ajax({
                url: baseUrl + "Group/GroupSettleUps",
                type: "GET",
                data: { groupId },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#group-settleup").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        // Fetch add settlement modal
        function fetchSettlementModal(amount, groupId = 0, friendUserId = 0, settleAll = false) {
            $("#regularModalContent").empty();
            $.ajax({
                url: baseUrl + "Settlement/SettlementModal",
                type: "POST",
                data: { amount, groupId, friendUserId, settleAll },
                success: function (response) {
                    if (!response.statusCode) {
                        $("#regularModalContent").html(response);
                        $("#regularModal").modal("show");
                    }
                },
                error: function () {
                    $("#regularModal").modal("hide");
                    toastr.error(SERVER_ERR);
                },
            });
        }

        // Save form
        $(document).on("submit", "#settlementForm", function (e) {
            e.preventDefault();

            if (!parseFloat($("#Amount").val())) {
                toastr.error("Enter amount greater then zero.");
                return;
            }

            let formData = new FormData(this);

            $.ajax({
                url: $(this).attr("action"),
                type: $(this).attr("method"),
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success) {
                            toastr.success(response.message);
                            fetchGroupName();
                            fetchGroupSettleUps('@Model.Id');
                            settlementSuccess();
                            // Settled up image
                            setSettledUpImage();
                        }
                        else if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#regularModalContent").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        });

        // Set settled up image
        function setSettledUpImage() {
            $("#settleUpModalTitle").html(`Payment recorded`);
            let image = `<img src="${baseUrl}images/settled-up.png" class="mx-auto my-5" alt="" width="200px" height="200px">`;
            $("#settlementForm").replaceWith(image);
        }
    </script>

    @* Export group expenses *@
    <script>
        function exportGroupExpenses() {
            let filter = {
                SearchString: $("#groupExpenseListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder
            };

            exportExcelAjax(filter, "Expense/ExportGroupExpenses", `${'@Model.Name'}_Group_Expenses`, '@Model.Id');
        }
    </script>

    @* Export Group activity *@
    <script>
        // Export activities
        function exportActivities() {
            if (validateDates()) {
                let filter = {
                    SearchString: $("#activitySearch").val(),
                    FromDate: $("#fromDate").val(),
                    ToDate: $("#toDate").val()
                };

                exportExcelAjax(filter, "Activity/ExportActivity", `Activities_of_group_${'@Model.Name'}`, '@Model.Id');
            }
        }
    </script>

    @* Group Analytics *@
    <script>
        function fetchGroupAnalytics(groupId){
            $("#group-analytics").empty();
            $.ajax({
                url: baseUrl + "Group/GroupAnalytics",
                type: "GET",
                data: { groupId },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#group-analytics").html(response);
                            generateChart();
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>

    @* Delete group expense *@
    <script>
        function deleteGroupExpense(expenseId, expenseName) {
            $("#confirmationModalTitle").text(`Delete expense`);
            $("#confirmationModalBody").html(`<span>Are you sure you want to delete expense <strong>${expenseName}?</strong></span>`);
            $("#confirmationModalYesBtn").attr("onclick", `deleteGroupExpenseConfirm(${expenseId})`);
            $("#confirmationModal").modal("show");
        }

        function deleteGroupExpenseConfirm(expenseId) {
            $.ajax({
                url: baseUrl + "Expense/DeleteExpense",
                type: "POST",
                data: { expenseId },
                success: function (response) {
                    $("#confirmationModal").modal("hide");
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            toastr.success(response.message);
                            getGroupExpenseList(1);
                            fetchGroupName();
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>
}
