@model int

<div class="modal-header">
    <h1 class="modal-title fs-5">Add new members</h1>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="d-flex align-items-center justify-content-between px-2 mb-3">
        <input type="text" class="searchBox form-control border-secondary-subtle rounded-0" id="friendSearch"
            placeholder="Search">
        <button class="btn btn-primary w-125px" type="button" id="addMembreBtn"
            onclick="addSelectedMembers()">Add</button>
    </div>
    <div id="friendListOuter" class="listOuter bg-white"></div>
</div>
<div class="modal-footer"></div>


@* Get friend list *@
<script>
    sortColumn = "";
    sortOrder = "";
    searchTimeout;

    $("#friendSearch").on("input", function () {
        if (searchTimeout === null) {
            searchTimeout = setTimeout(function () {
                getFriendList(1);
            }, 500);
        }
    });

    $(document).ready(function () {
        getFriendList(1);
    });

    function getFriendList(currentPage) {
        clearTimeout(searchTimeout);
        searchTimeout = null;

        let filter = {
            PageNumber: currentPage,
            PageSize: $("#friendPageSize").val(),
            SearchString: $("#friendSearch").val(),
            SortColumn: sortColumn,
            SortOrder: sortOrder,
            HasActions: false,
            HasCkb: true
        };

        $.ajax({
            url: baseUrl + "Friend/FriengListForGroup",
            type: "POST",
            data: { filter, groupId: @Model },
            success: function (response) {
                if (!response.statusCode) {
                    if (response.success == false) {
                        toastr.error(response.message);
                    }
                    else {
                        $("#friendListOuter").html(response);
                        checkSelectedUsers();
                    }
                }
            },
            error: function () {
                toastr.error(SERVER_ERR);
            }
        });
    }

    // Handle sorting
    $(document).on("click", ".sortBtn", function () {
        sortColumn = $(this).data("column");
        sortOrder = $(this).data("order");
        getFriendList(1);
    });

</script>

@* Add new member *@
<script>
    $(document).on("change", ".userCkb", function () {
        let userId = $(this).data("userid");

        if (selectedUserIds.includes(userId)) {
            selectedUserIds = selectedUserIds.filter(n => n !== userId);
        }
        else {
            selectedUserIds.push(userId);
        }
    });

    function checkSelectedUsers() {
        $(".userCkb").each(function () {
            let userId = $(this).data("userid");
            $(this).prop("checked", selectedUserIds.includes(userId));
        });
    }

    function addSelectedMembers() {
        if (!selectedUserIds.length) {
            toastr.error("Select atleast one friend.")
        }
        else {
            $.ajax({
                url: baseUrl + "Group/AddSelectedUsers",
                type: "POST",
                data: { groupId: @Model, selectedUserIds },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            toastr.success(response.message);
                            getFriendList(1);
                            fetchGroupMembers();
                            searchActivities();
                            selectedUserIds = [];
                            $("#largeModal").modal("hide");
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    }

    function addToGroup(userId) {
        $.ajax({
            url: baseUrl + "Group/AddGroupMembers",
            type: "POST",
            data: { groupId: @Model, userId },
            success: function (response) {
                if (!response.statusCode) {
                    if (response.success == false) {
                        toastr.error(response.message);
                    }
                    else {
                        toastr.success(response.message);
                        getFriendList(1);
                        fetchGroupMembers();
                        searchActivities();
                    }
                }
            },
            error: function () {
                toastr.error(SERVER_ERR);
            }
        });
    }
</script>