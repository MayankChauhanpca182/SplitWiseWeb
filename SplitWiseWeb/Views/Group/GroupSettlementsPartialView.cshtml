@model List<GroupMemberVM>
@{
    int currentUserId = int.Parse(User.FindFirst("id")?.Value);
}

@if (Model.Count() == 0)
{
    <div class="d-flex flex-column align-items-center p-4 gap-3">
        <img src="/images/checked.png" alt="" width="100px" height="100px">
        <span class="text-primary fs-3 fw-semibold">You don't owe anything in this group</span>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (GroupMemberVM user in Model)
        {
            @if(user.UserId != currentUserId)
            {
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 w-100">
                        <div class="d-flex align-items-center gap-2">
                            <img src=@(user.ProfileImagePath ?? "/images/Default_pfp.png") alt="" class="img-50px rounded-circle border border-dark-subtle object-fit-cover">
                            <div class="d-flex flex-column">
                                <span class="text-nowrap">
                                    @user.Name
                                </span>
                                <span class="text-nowrap">
                                    @user.EmailAddress
                                </span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="@(user.Expense < 0 ? "text-danger" : "text-success")">
                                @(user.Expense == 0 ? $"Expense is settled" : (user.Expense > 0 ? $"You lent ₹{user.Expense.ToString("N2")}" : $"You owe ₹{((-1)*user.Expense).ToString("N2")}"))
                            </span>
                            @if(user.Expense < 0)
                            {
                                <button type="button" class="settleUpBtn btn btn-primary text-nowrap" onclick="fetchSettlementModal('@((-1)*(user.Expense))', @user.GroupId, @user.UserId, false)">Settle Up</button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}