@model GroupVM

<img src="@(Model.ImagePath ?? "/images/default_group_img.png")" alt="Image" class="rounded-circle border border-dark-subtle object-fit-cover" width="70px" height="70px">
<div class="d-flex flex-column">
    <span>
        @Model.Name
        <button type="button" class="btn border-0 px-0" title="Edit Group" onclick="fetchAddGroupModal(@Model.Id)">
            <i class="bi bi-pencil-square"></i>
        </button>
    </span>
    <span class="fs-5 fw-normal @(Model.Expense < 0 ? "text-danger" : "text-success")">
        @(Model.Expense == 0 ? $"Expense is settled" : (Model.Expense > 0 ? $"You are owed ₹{Model.Expense.ToString("N2")}"
            : $"You owe ₹{((-1) * Model.Expense).ToString("N2")}"))
    </span>
</div>