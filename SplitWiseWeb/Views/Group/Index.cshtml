@using SplitWiseService.Constants
@{
    ViewData["Title"] = "Groups";
}

<breadcrumb></breadcrumb>
<h3 class="bg-white mb-3 p-3 text-dark-emphasis shadow">Groups</h3>
<div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
    <div class="d-flex align-items-center gap-4">
        <input type="text" class="searchBox form-control border-secondary-subtle rounded-0" id="groupListSearch"
            placeholder="Search">
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary w-125px" type="button" onclick="exportGroups()">Export</button>
        <button class="btn btn-primary w-125px" type="button" onclick="fetchAddGroupModal()">Add Group</button>
        <a asp-action="AddGroupExpense" asp-controller="Expense" class="btn btn-primary w-125px" type="button">Add Expense</a>
    </div>
</div>
<div id="groupListOuter" class="listOuter bg-white p-3"></div>


@section Scripts {

    <script src="@Url.Content("~/js/group.js")"></script>

    @* Group list *@
    <script>
        sortColumn = "";
        sortOrder = "";

        $(document).ready(function () {
            getGroupList(1);
        });

        $("#groupListSearch").on("input", function () {
            if (searchTimeout === null) {
                searchTimeout = setTimeout(function () {
                    getGroupList(1);
                }, 500);
            }
        });

        function getGroupList(currentPage = 1) {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                PageNumber: currentPage,
                PageSize: $("#groupListPageSize").val(),
                SearchString: $("#groupListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder
            };

            $.ajax({
                url: baseUrl + "Group/GroupList",
                type: "POST",
                data: { filter },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#groupListOuter").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        // Handle sorting
        $(document).on("click", ".sortBtn", function () {
            sortColumn = $(this).data("column");
            sortOrder = $(this).data("order");
            getGroupList(1);
        });
    </script>

    @* Delte group *@
    <script>
        // Delete group
        function deleteGroupConfirm(groupId) {
            $.ajax({
                url: "/Group/DeleteGroup",
                type: "POST",
                data: { groupId },
                success: function (response) {
                    $("#confirmationModal").modal("hide");
                    if (!response.statusCode) {
                        if (response.success == true) {
                            toastr.success(response.message);
                            getGroupList(1);
                        }
                        else {
                            toastr.error(response.message);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
        function deleteGroup(groupId, groupName) {
            $("#confirmationModalTitle").text(`Delete Group`);
            $("#confirmationModalBody").html(`<span>Are you sure you want to delete <strong>${groupName}</strong> group?</span>`);
            $("#confirmationModalYesBtn").attr("onclick", `deleteGroupConfirm(${groupId})`);
            $("#confirmationModal").modal("show");
        }
    </script>

    @* Export groups *@
    <script>
        function exportGroups() {
            let filter = {
                SearchString: $("#groupListSearch").val()
            };

            exportExcelAjax(filter, "/Group/ExportGroups", "Groups");
        }
    </script>
}
