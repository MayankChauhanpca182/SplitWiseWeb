@model GroupAnalyticsVM
@{
    List<string> categoryList = Model.CategoryExpenseChart.Select(d => d.Category).ToList();
    List<decimal> categoryExpenseList = Model.CategoryExpenseChart.Select(d => d.Expense).ToList();

    List<string> memberList = Model.MemberExpenseCharts.Select(d => d.Member).ToList();
    List<decimal> memberExpenseList = Model.MemberExpenseCharts.Select(d => d.Expense).ToList();

    List<string> bgColors = new List<string> { Model.BaseColor.Replace("{0}", "1") };

    int maxCount = categoryList.Count > memberList.Count ? categoryList.Count : memberList.Count;

    if (maxCount > 1)
    {
        double fraction = (1 - 0.25) / (maxCount - 1);

        for (int i = 1; i < maxCount; i++)
        {
            bgColors.Add(Model.BaseColor.Replace("{0}", (1 - (i * fraction)).ToString()));
        }
    }
}

<p class="fw-bold fs-5 text-dark-emphasis text-center pb-4">Total Expense: <span>₹@Model.TotalExpense.ToString("N2")</span></p>

<div class="d-flex justify-content-evenly">
    <div class="chartContainer">
        <canvas class="pieChartCanvas" id="category-expense-chart"></canvas>
    </div>
    <div class="chartContainer">
        <canvas class="pieChartCanvas" id="member-expense-chart"></canvas>
    </div>
</div>


<script>
    function generateChart() {
        const total = @Model.TotalExpense;

        // Category vs expense chart
        const categoryExpenseChartData = {
            labels: @Html.Raw(Json.Serialize(categoryList)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(categoryExpenseList))
            }]
        };

        const categoryExpenseChartConfig = {
            type: 'pie',
            data: categoryExpenseChartData,
            options: {
                plugins: {
                    title: {
                        display: true,
                        text: 'Expense vs Category',
                        font: {
                            size: 18
                        },
                        padding: {
                            top: 10,
                            bottom: 20
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let amount = context.raw;
                                let percentage = ((amount / total) * 100).toFixed(1) + '%';
                                return `${context.label}: ₹${amount} (${percentage})`;
                            }
                        }
                    },
                    datalabels: {
                        display: true,
                        align: "center",
                        color: '#000',
                        formatter: function (value, context) {
                            const category = context.chart.data.labels[context.dataIndex];
                            let percentage = ((value / total) * 100).toFixed(1) + '%';
                            return `${category}\n${percentage}\n₹${value}`;
                        },
                        font: {
                            weight: 'bold',
                            size: 12
                        }
                    },
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            padding: 15
                        }
                    }
                }
            }
        };
        
        // Category vs expense chart
        const memberExpenseChartData = {
            labels: @Html.Raw(Json.Serialize(memberList)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(memberExpenseList))
            }]
        };

        const memberExpenseChartConfig = {
            type: 'pie',
            data: memberExpenseChartData,
            options: {
                plugins: {
                    title: {
                        display: true,
                        text: 'Expense vs Member',
                        font: {
                            size: 18
                        },
                        padding: {
                            top: 10,
                            bottom: 20
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let amount = context.raw;
                                let percentage = ((amount / total) * 100).toFixed(1) + '%';
                                return `${context.label}: ₹${amount} (${percentage})`;
                            }
                        }
                    },
                    datalabels: {
                        display: true,
                        align: "center",
                        color: '#000',
                        formatter: function (value, context) {
                            const member = context.chart.data.labels[context.dataIndex];
                            let percentage = ((value / total) * 100).toFixed(1) + '%';
                            return `${member}\n${percentage}\n₹${value}`;
                        },
                        font: {
                            weight: 'bold',
                            size: 12
                        }
                    },
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            padding: 15
                        }
                    }
                }
            }
        };

        setTimeout(function () {
            Chart.register(ChartDataLabels);
            new Chart(document.getElementById('category-expense-chart'), categoryExpenseChartConfig);
            new Chart(document.getElementById('member-expense-chart'), memberExpenseChartConfig);
        }, 500);
    }
</script>
