@model LoginVM
@{
    ViewData["Title"] = "Welcome";
    Layout = "_LoginLayout";
}

<div class="clientPage">
    <!-- Header -->
    <header class="clientPageHeader">
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Auth" asp-action="Index" class="navbar-brand d-flex justify-content-center gap-3">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="" width="60px">
                <span class="text-secondary fs-3 fw-semibold">SplitMate</span>
            </a>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Login" asp-controller="Auth" class="text-primary fw-semibold">Log in</a>
            <a asp-action="Register" asp-controller="User" class="btn btn-primary">Sign Up</a>
        </div>
    </header>

    <div class="facets">
        <div class="container mx-auto px-5 py-5">
            <div class="section">
                <span class="fs-1 fw-semibold mb-3">Less stress when sharing <span
                        class="text-secondary">expenses.</span></span>
                <span class="fs-5 mb-3">Keep track of your shared expenses and balances with housemates, groups,
                    friends, and family.</span>
                <a asp-action="Register" asp-controller="User" class="btn btn-primary p-2 w-40 fs-4">Sign Up</a>
            </div>
            <div class="section" id="facetsImageContainer">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
            </div>
        </div>
    </div>

    <div class="featuresDemoOuter">
        <div class="featuresDemo bg-charcoal">
            <p class="text-center text-white d-flex flex-column align-items-center">
                <span class="fs-3 fw-semibold mb-2">Track balances</span>
                <span class="w-30">Keep track of shared expenses, balances, and who owes who.</span>
            </p>
            <div class="demoImageOuter">
                <img src="/images/demos/friend-list.png" alt="">
            </div>
        </div>
        <div class="featuresDemo bg-primary">
            <p class="text-center text-white d-flex flex-column align-items-center">
                <span class="fs-3 fw-semibold mb-2">Organize expenses</span>
                <span class="w-30">Split expenses with any group: trips, housemates, friends, and family.</span>
            </p>
            <div class="demoImageOuter">
                <img src="/images/demos/friend-detail.png" alt="">
            </div>
        </div>
    </div>

    <div class="featuresDemoOuter">
        <div class="featuresDemo bg-orange-bright">
            <p class="text-center text-white d-flex flex-column align-items-center">
                <span class="fs-3 fw-semibold mb-2">Add expenses easily</span>
                <span class="w-30">Quickly add expenses on the go before you forget who paid.</span>
            </p>
            <div class="demoImageOuter">
                <img src="/images/demos/add-expense.png" alt="">
            </div>
        </div>
        <div class="featuresDemo bg-charcoal">
            <p class="text-center text-white d-flex flex-column align-items-center">
                <span class="fs-3 fw-semibold mb-2">Pay friends back</span>
                <span class="w-30">Settle up with a friend and record any cash or online payment.</span>
            </p>
            <div class="demoImageOuter">
                <img src="/images/demos/settle-up.png" alt="">
            </div>
        </div>
    </div>

    <div class="p-5 pb-0 w-100">
        <p class="fs-2 fw-semibold text-center">The whole shebang</p>
        <div class="featureList">
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Add friends and groups</span>
            </span>
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Split expenses, record debts</span>
            </span>
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Unlimited expenses</span>
            </span>
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Equal or unequal splits</span>
            </span>
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Split by percentage</span>
            </span>
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Split by share</span>
            </span>
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Spending totals</span>
            </span>
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Expense search</span>
            </span>
            <span class="featureItem">
                <img src="/images/splitmate/icononly_transparent_nobuffer.png" alt="">
                <span class="fs-5">Chart analytics</span>
            </span>
        </div>
    </div>

    <div class="w-100 p-5">
        <div class="commentCardsOuter">
            <div class="commentCard">
                <span class="fs-5">“Fundamental” for tracking finances. As good as WhatsApp for containing
                    awkwardness.</span>
                <span class="fw-semibold fs-5"><i>Mr. Bhavik Valand</i></span>
            </div>
            <div class="commentCard">
                <span class="fs-5">Life hack for group trips. Amazing tool to use when traveling with friends! Makes
                    life so easy!!</span>
                <span class="fw-semibold fs-5"><i>Mr. Dipan Kadia</i></span>
            </div>
            <div class="commentCard">
                <span class="fs-5">Makes it easy to split everything from your dinner bill to rent.</span>
                <span class="fw-semibold fs-5"><i>Mr. Milan Siddhpura</i></span>
            </div>
            <div class="commentCard">
                <span class="fs-5">So amazing to have this app manage balances and help keep money out of relationships.
                    love it!</span>
                <span class="fw-semibold fs-5"><i>Mr. Harsh Patel</i></span>
            </div>
            <div class="commentCard">
                <span class="fs-5">I never fight with roommates over bills because of this genius expense-splitting
                    website.</span>
                <span class="fw-semibold fs-5"><i>Mr. Dhaval Gohel</i></span>
            </div>
            <div class="commentCard">
                <span class="fs-5">I use it everyday. I use it for trips, roommates, loans. I love splitwise.</span>
                <span class="fw-semibold fs-5"><i>Mr. Hemrajsinh Jethwa</i></span>
            </div>
        </div>
    </div>

    <div class="quickLinks mb-2 px-5 mb-4">
        <span class="d-flex gap-3 justify-content-center">
            <a asp-action="Login" asp-controller="Auth" class="text-primary fw-semibold">Log in</a>
            <span>|</span>
            <a asp-action="Register" asp-controller="User" class="text-primary fw-semibold">Sign up</a>
            <span>|</span>
            <a asp-action="ForgotPassword" asp-controller="Auth" class="text-primary fw-semibold">Forgot
                password</a>
        </span>
    </div>

    <svg viewBox="0 0 3000 500" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">

        <!-- BACKGROUND LAYER -->
        <g opacity="0.3">
            <polygon points="0,500 300,180 600,500" fill="#2F3E46" />
            <polygon points="500,500 800,150 1100,500" fill="#3E4F56" />
            <polygon points="1000,500 1300,190 1600,500" fill="#2C3B42" />
            <polygon points="1500,500 1800,170 2100,500" fill="#263238" />
            <polygon points="2000,500 2300,200 2600,500" fill="#1E272C" />
        </g>

        <!-- MIDDLE LAYER -->
        <g opacity="0.5">
            <polygon points="150,500 450,120 750,500" fill="#475B63" />
            <polygon points="650,500 950,140 1250,500" fill="#5A6E76" />
            <polygon points="1150,500 1450,90 1750,500" fill="#425057" />
            <polygon points="1650,500 1950,130 2250,500" fill="#374145" />
            <polygon points="2150,500 2450,100 2750,500" fill="#2C363A" />
        </g>

        <!-- FOREGROUND LAYER: Big, colorful triangles -->
        <g opacity="1">
            <polygon points="0,500 250,80 500,500" fill="#54595F" />
            <polygon points="250,80 500,500 250,500" fill="#3A3E42" />

            <polygon points="500,500 750,90 1000,500" fill="#34373A" />
            <polygon points="750,90 1000,500 750,500" fill="#222426" />

            <polygon points="1000,500 1250,60 1500,500" fill="#1FCBAE" />
            <polygon points="1250,60 1500,500 1250,500" fill="#15A78E" />

            <polygon points="1500,500 1750,100 2000,500" fill="#0D6C5A" />
            <polygon points="1750,100 2000,500 1750,500" fill="#095345" />

            <polygon points="2000,500 2250,60 2500,500" fill="#FF7F5F" />
            <polygon points="2250,60 2500,500 2250,500" fill="#E76043" />

            <polygon points="2500,500 2750,90 3000,500" fill="#FF1C00" />
            <polygon points="2750,90 3000,500 2750,500" fill="#C81600" />
        </g>

    </svg>
</div>
