@model FriendVM
@{
    ViewData["Title"] = "Friend Details";
    int currentUserId = int.Parse(User.FindFirst("id")?.Value);
}

<breadcrumb></breadcrumb>
<h3
    class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white mb-3 p-3 text-dark-emphasis shadow">
    <div class="d-flex align-items-center gap-3" id="group-name">
        <img src="@(Model.ProfileImagePath ?? "/images/Default_pfp.png")" alt="Image" class="rounded-circle border border-dark-subtle object-fit-cover" width="70px" height="70px">
        <div class="d-flex flex-column">
            <span>
                @Model.Name
            </span>
            <span class="fs-5 fw-normal @(Model.Expense < 0 ? "text-danger" : "text-success")">
                @(Model.Expense == 0 ? $"Expense is settled" : (Model.Expense > 0 ? $"You are owed ₹{Model.Expense.ToString("N2")}"
                    : $"You owe ₹{((-1) * Model.Expense).ToString("N2")}"))
            </span>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        @if(Model.Expense < 0)
        {
            <a asp-controller="Settlement" asp-action="Index" asp-route-friendUserId="@Model.UserId" class="btn btn-primary border-0" title="Settle Up">Settle Up</a>
        }
        <button type="button" class="btn btn-secondary back-btn">Back</button>
    </div>
</h3>

<div class="bg-white p-3" id="friendDetailContainer">
    <ul class="nav nav-underline mb-3" id="pills-tab" role="tablist">
        
    </ul>

    <div class="tab-content" id="pills-tabContent">
        
    </div>
</div>

