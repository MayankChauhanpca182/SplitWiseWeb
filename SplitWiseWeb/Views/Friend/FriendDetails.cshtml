@model FriendVM
@{
    ViewData["Title"] = "Friend Details";
    int currentUserId = int.Parse(User.FindFirst("id")?.Value);
}

<breadcrumb></breadcrumb>
<h3
    class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white mb-3 p-3 text-dark-emphasis shadow">
    <div class="d-flex align-items-center gap-3" id="group-name">
        <img src="@(Model.ProfileImagePath ?? "/images/Default_pfp.png")" alt="Image" class="rounded-circle border border-dark-subtle object-fit-cover" width="70px" height="70px">
        <div class="d-flex flex-column">
            <span>
                @Model.Name
            </span>
            <span class="fs-5 fw-normal @(Model.Expense < 0 ? "text-danger" : "text-success")">
                @(Model.Expense == 0 ? $"Expense is settled" : (Model.Expense > 0 ? $"You are owed ₹{Model.Expense.ToString("N2")}"
                    : $"You owe ₹{((-1) * Model.Expense).ToString("N2")}"))
            </span>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        @if(Model.Expense < 0)
        {
            <a asp-controller="Settlement" asp-action="Index" asp-route-friendUserId="@Model.UserId" class="btn btn-primary border-0" title="Settle Up">Settle Up</a>
        }
        <button type="button" class="btn btn-secondary back-btn">Back</button>
    </div>
</h3>

<div class="bg-white p-3" id="friendDetailContainer">
    <ul class="nav nav-underline mb-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="friend-activity-tab" data-bs-toggle="pill" data-bs-target="#friend-activity"
                type="button" role="tab" aria-controls="friend-activity" aria-selected="false"
                onclick="fetchActivities()">Activities</button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="friend-activity" role="tabpanel" aria-labelledby="friend-activity-tab">
            <partial name="../Activity/ActivityFilterPartialView" model="@Model.ActivityFilter" />
            <div id="friend-activity-outer" class="listOuter"></div>
        </div>
    </div>
</div>

@section Scripts{
    @* Friend activities *@
    <script src="/js/activity.js"></script>
    <script>
        // Fetch activities
        function fetchActivities() {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                SearchString: $("#activitySearch").val(),
                FromDate: $("#fromDate").val(),
                ToDate: $("#toDate").val()
            };

            if ((!filter.FromDate || !filter.ToDate) && !(filter.FromDate && filter.ToDate)) {
                return;
            }
            else if (filter.FromDate && filter.ToDate) {
                if (filter.FromDate > filter.ToDate) {
                    toastr.error("From Date should be greater then To Date.")
                    $("#toDate").val("");
                    return;
                }
            }

            $.ajax({
                url: "/Activity/ActivityList",
                type: "POST",
                data: { filter, friendUserId: '@Model.UserId' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#friend-activity-outer").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error("Internal server error");
                }
            });
        }
    </script>
}