@model FriendVM
@{
    ViewData["Title"] = "Friend Details";
    int currentUserId = int.Parse(User.FindFirst("id")?.Value);
}

<breadcrumb></breadcrumb>
<h3
    class="d-flex flex-wrap justify-content-between align-items-center gap-3 bg-white mb-3 p-3 text-dark-emphasis shadow">
    <div class="d-flex align-items-center gap-3" id="friend-name">
        <img src="~@(Model.ProfileImagePath ?? "/images/Default_pfp.png")" alt="" class="img-70px rounded-circle border border-dark-subtle object-fit-cover" id="friendImage">
        <div class="d-flex flex-column">
            <span id="friendName">
                @Model.Name
            </span>
            <span class="fs-5 fw-normal @(Model.Expense < 0 ? "text-danger" : "text-success")" id="friendExpense">
                @(Model.Expense == 0 ? $"Expense is settled" : (Model.Expense > 0 ? $"You are owed ₹{Model.Expense.ToString("N2")}"
                    : $"You owe ₹{((-1) * Model.Expense).ToString("N2")}"))
            </span>
        </div>
        <button class="btn btn-primary" onclick="fetchfriendDetails()"></button>
    </div>

    <div class="d-flex align-items-center gap-2">
        @if(Model.Expense < 0)
        {
            <a asp-controller="Settlement" asp-action="SettleUp" asp-route-friendUserId="@Model.UserId" class="settleUpBtn btn btn-primary border-0" title="Settle Up">Settle Up</a>
        }
        <button type="button" class="btn btn-secondary back-btn">Back</button>
    </div>
</h3>

<div class="bg-white p-3" id="friendDetailContainer">
    <ul class="nav nav-underline mb-3" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="friend-expenses-tab" data-bs-toggle="pill" data-bs-target="#friend-expenses"
                type="button" role="tab" aria-controls="friend-expenses" aria-selected="true"
                onclick="fetchFriendExpenses(1)">Expenses</button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="friend-activity-tab" data-bs-toggle="pill" data-bs-target="#friend-activity"
                type="button" role="tab" aria-controls="friend-activity" aria-selected="false"
                onclick="fetchActivities()">Activities</button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link" id="friend-transactions-tab" data-bs-toggle="pill" data-bs-target="#friend-transactions"
                type="button" role="tab" aria-controls="friend-transactions" aria-selected="true"
                onclick="fetchFriendTransactions(1)">Transactions</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="friend-analytics-tab" data-bs-toggle="pill" data-bs-target="#friend-analytics"
                type="button" role="tab" aria-controls="friend-analytics" aria-selected="true"
                onclick="fetchFriendAnalytics(@Model.UserId)">Analytics</button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <div class="tab-pane fade show active" id="friend-expenses" role="tabpanel" aria-labelledby="friend-expenses-tab">
            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <input type="text" class="searchBox form-control border-secondary-subtle rounded-0"
                        id="friendExpenseListSearch" placeholder="Search">
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary w-125px" type="button" onclick="exportFriendExpenses()">Export</button>
                </div>
            </div>
            <div id="friendExpensesOuter" class="listOuter bg-white"></div>
        </div>

        <div class="tab-pane fade" id="friend-activity" role="tabpanel" aria-labelledby="friend-activity-tab">
            <partial name="../Activity/ActivityFilterPartialView" model="@Model.ActivityFilter" />
            <div id="friend-activity-outer" class="listOuter"></div>
        </div>

        <div class="tab-pane fade" id="friend-transactions" role="tabpanel" aria-labelledby="friend-transactions-tab">
            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <input type="text" class="searchBox form-control border-secondary-subtle rounded-0"
                        id="transactionListSearch" placeholder="Search by expense amount">
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary w-125px" type="button" onclick="exportTransactions()">Export</button>
                </div>
            </div>
            <div id="transactionListOuter" class="listOuter bg-white"></div>
        </div>

        <div class="tab-pane fade" id="friend-analytics" role="tabpanel" aria-labelledby="friend-analytics-tab"></div>
    </div>
</div>

@section Scripts{
    @* Friend activities *@
    <script src="/js/activity.js"></script>
    <script>
        // Fetch activities
        function fetchActivities() {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                SearchString: $("#activitySearch").val(),
                FromDate: $("#fromDate").val(),
                ToDate: $("#toDate").val()
            };

            if ((!filter.FromDate || !filter.ToDate) && !(filter.FromDate && filter.ToDate)) {
                return;
            }
            else if (filter.FromDate && filter.ToDate) {
                if (filter.FromDate > filter.ToDate) {
                    toastr.error("From Date should be greater then To Date.")
                    $("#toDate").val("");
                    return;
                }
            }

            $.ajax({
                url: "/Activity/ActivityList",
                type: "POST",
                data: { filter, friendUserId: '@Model.UserId' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#friend-activity-outer").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>

    @* Transaction list *@
    <script>
        sortColumn = "";
        sortOrder = "";

        $("#transactionListSearch").on("input", function () {
            if (searchTimeout === null) {
                searchTimeout = setTimeout(function () {
                    fetchFriendTransactions(1);
                }, 500);
            }
        });

        function fetchFriendTransactions(currentPage = 1) {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                PageNumber: currentPage,
                PageSize: $("#transactionListPageSize").val(),
                SearchString: $("#transactionListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder
            };

            $.ajax({
                url: "/Payment/FriendPaymentList",
                type: "POST",
                data: { filter, friendUserId: '@Model.UserId' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#transactionListOuter").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        // Handle sorting
        $(document).on("click", ".sortBtn", function () {
            sortColumn = $(this).data("column");
            sortOrder = $(this).data("order");
            fetchFriendTransactions(1);
        });
    </script>

    @* Expense list *@
    <script>
        sortColumn = "";
        sortOrder = "";

        $("#friendExpenseListSearch").on("input", function () {
            if (searchTimeout === null) {
                searchTimeout = setTimeout(function () {
                    fetchFriendExpenses(1);
                }, 500);
            }
        });

        $(document).ready(function () {
            fetchFriendExpenses(1);
        });

        function fetchFriendExpenses(currentPage = 1) {
            clearTimeout(searchTimeout);
            searchTimeout = null;

            let filter = {
                PageNumber: currentPage,
                PageSize: $("#friendExpensePageSize").val(),
                SearchString: $("#friendExpenseListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder
            };

            $.ajax({
                url: "/Expense/FriendExpenseList",
                type: "POST",
                data: { filter, friendUserId: '@Model.UserId' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#friendExpensesOuter").html(response);
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }

        // Handle sorting
        $(document).on("click", ".sortBtn", function () {
            sortColumn = $(this).data("column");
            sortOrder = $(this).data("order");
            fetchFriendExpenses(1);
        });
    </script>

    @* Export friend expenses *@
    <script>
        function exportFriendExpenses() {
            let filter = {
                SearchString: $("#friendExpenseListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder
            };

            exportExcelAjax(filter, "/Expense/ExportFriendExpenses", `Expenses_with_${'@Model.Name'}`, 0, '@Model.UserId');
        }
    </script>

    @* Export friend transactions *@
    <script>
        function exportTransactions() {
            let filter = {
                SearchString: $("#transactionListSearch").val(),
                SortColumn: sortColumn,
                SortOrder: sortOrder
            };

            exportExcelAjax(filter, "/Payment/ExportPayments", `Payments_with_${'@Model.Name'}`, 0, '@Model.UserId');
        }
    </script>

    @* Export friend activity *@
    <script>
        // Export friend activities
        function exportActivities() {
            if (validateDates()) {
                let filter = {
                    SearchString: $("#activitySearch").val(),
                    FromDate: $("#fromDate").val(),
                    ToDate: $("#toDate").val()
                };

                exportExcelAjax(filter, "/Activity/ExportActivity", `Activities_with_${'@Model.Name'}`, null, '@Model.UserId');
            }
        }
    </script>

    @* Friend Analytics *@
    <script>
        function fetchFriendAnalytics(friendUserId){
            $("#friend-analytics").empty();
            $.ajax({
                url: "/Friend/FriendAnalytics",
                type: "GET",
                data: { friendUserId },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#friend-analytics").html(response);
                            generateChart();
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>

    @* Delete group expense *@
    <script>
        function deleteFriendExpense(expenseId, expenseName) {
            $("#confirmationModalTitle").text(`Delete expense`);
            $("#confirmationModalBody").html(`<span>Are you sure you want to delete expense <strong>${expenseName}?</strong></span>`);
            $("#confirmationModalYesBtn").attr("onclick", `deleteFriendExpenseConfirm(${expenseId})`);
            $("#confirmationModal").modal("show");
        }

        function deleteFriendExpenseConfirm(expenseId) {
            $.ajax({
                url: "/Expense/DeleteExpense",
                type: "POST",
                data: { expenseId },
                success: function (response) {
                    $("#confirmationModal").modal("hide");
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            toastr.success(response.message);
                            fetchFriendExpenses(1);
                            fetchfriendDetails();
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>

    @* Fetch friend details *@
    <script>
        function fetchfriendDetails() {
            $.ajax({
                url: "/Friend/FriendDetailJson",
                type: "GET",
                data: { friendUserId: '@Model.UserId' },
                success: function (response) {
                    if (!response.statusCode) {
                        if (response.success == false) {
                            toastr.error(response.message);
                        }
                        else {
                            $("#friendImage").prop("src", `~${response.profileImagePath ?? "/images/Default_pfp.png"}`);
                            $("#friendName").text(response.name);
                            $("#friendExpense").removeClass("text-success").removeClass("text-danger");
                            if(response.expense < 0){
                                $("#friendExpense").addClass("text-danger");
                                $("#friendExpense").text(`You owe ₹${formatToINR((-1)*response.expense)}`);
                            }
                            else if(response.expense === 0){
                                $("#friendExpense").addClass("text-success");
                                $("#friendExpense").text(`Expense is settled`);
                            }
                            else{
                                $("#friendExpense").addClass("text-success");
                                $("#friendExpense").text(`You are owed ₹${formatToINR(response.expense)}`);
                            }
                        }
                    }
                },
                error: function () {
                    toastr.error(SERVER_ERR);
                }
            });
        }
    </script>
}