@model FriendAnalyticsVM
@{
    List<string> categoryList = Model.CategoryExpenseChart.Select(d => d.Category).ToList();
    List<decimal> categoryExpenseList = Model.CategoryExpenseChart.Select(d => d.Expense).ToList();

    List<string> groupTypeList = Model.GroupTypeExpenseCharts.Select(d => d.Category).ToList();
    List<decimal> groupTypeExpenseList = Model.GroupTypeExpenseCharts.Select(d => d.Expense).ToList();
}

<p class="fw-bold fs-5 text-dark-emphasis text-center pb-4">Total Expense:
    <span>₹@Model.TotalExpense.ToString("N2")</span></p>

<div class="d-flex justify-content-evenly">
    @if (Model.TotalExpense > 0)
    {
        <div class="chartContainer">
            <canvas class="pieChartCanvas" id="category-expense-chart"></canvas>
        </div>
        <div class="chartContainer">
            <canvas class="pieChartCanvas" id="group-type-expense-chart"></canvas>
        </div>
    }
</div>


<script>
    function generateChart() {
        const total = @Model.TotalExpense;

        // Category vs expense chart
        const categoryExpenseChartData = {
            labels: @Html.Raw(Json.Serialize(categoryList)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(categoryExpenseList))
            }]
        };

        const categoryExpenseChartConfig = {
            type: 'pie',
            data: categoryExpenseChartData,
            options: {
                plugins: {
                    title: {
                        display: true,
                        text: 'Expense vs Category',
                        font: {
                            size: 18
                        },
                        padding: {
                            top: 10,
                            bottom: 20
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let amount = context.raw;
                                let percentage = ((amount / total) * 100).toFixed(1) + '%';
                                return `${context.label}: ₹${amount} (${percentage})`;
                            }
                        }
                    },
                    datalabels: {
                        display: true,
                        align: "center",
                        color: '#000',
                        formatter: function (value, context) {
                            const category = context.chart.data.labels[context.dataIndex];
                            let percentage = ((value / total) * 100).toFixed(1) + '%';
                            return `${category}\n${percentage}\n₹${value}`;
                        },
                        font: {
                            weight: 'bold',
                            size: 12
                        }
                    },
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            padding: 15
                        }
                    }
                }
            }
        };

        // Category vs expense chart
        const groupTypeExpenseChartData = {
            labels: @Html.Raw(Json.Serialize(groupTypeList)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(groupTypeExpenseList))
            }]
        };

        const groupTypeExpenseChartConfig = {
            type: 'pie',
            data: groupTypeExpenseChartData,
            options: {
                plugins: {
                    title: {
                        display: true,
                        text: 'Expense vs Group type',
                        font: {
                            size: 18
                        },
                        padding: {
                            top: 10,
                            bottom: 20
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let amount = context.raw;
                                let percentage = ((amount / total) * 100).toFixed(1) + '%';
                                return `${context.label}: ₹${amount} (${percentage})`;
                            }
                        }
                    },
                    datalabels: {
                        display: true,
                        align: "center",
                        color: '#000',
                        formatter: function (value, context) {
                            const typeName = context.chart.data.labels[context.dataIndex];
                            let percentage = ((value / total) * 100).toFixed(1) + '%';
                            return `${typeName}\n${percentage}\n₹${value}`;
                        },
                        font: {
                            weight: 'bold',
                            size: 12
                        }
                    },
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            padding: 15
                        }
                    }
                }
            }
        };

        setTimeout(function () {
            Chart.register(ChartDataLabels);
            new Chart(document.getElementById('category-expense-chart'), categoryExpenseChartConfig);
            new Chart(document.getElementById('group-type-expense-chart'), groupTypeExpenseChartConfig);
        }, 500);
    }
</script>
